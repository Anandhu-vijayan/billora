# Copy to .env.local and fill in real values. Never commit .env.local.
# Client-side (browser). MUST be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
# Required by /api/health/supabase and any service_role code.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://xyzcompany.supabase.co/auth/v1/.well-known/jwks.json

# WhatsApp Cloud API (webhook verification + media download).
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App Secret on the Meta dashboard. Validates the
# X-Hub-Signature-256 webhook header. REQUIRED in production (fail-closed).
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Abuse / provider-quota guard: max NEW invoices one workspace may file per UTC
# day at the WhatsApp intake (bounds runaway Gemini/OCR/storage cost from a
# spamming sender). Set 0 to disable. Default when unset: 200.
WHATSAPP_MAX_INVOICES_PER_DAY=200
# Keyed HMAC for WhatsApp sender identities (server only, never NEXT_PUBLIC_).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_IDENTITY_HMAC_KEY=

# OPT-IN PROACTIVE DELIVERY (off by default). Billora normally only REPLIES inside
# WhatsApp's 24h service window and never stores the raw phone (identity is a one-way
# HMAC), so a finished register is handed to the owner on their NEXT inbound message.
# Proactive delivery is a deliberate, REVERSIBLE exception the owner opts into (reply
# "Proactive on"), so it is gated THREE ways — ALL required before anything is pushed
# unprompted: (1) WHATSAPP_PROACTIVE_DELIVERY=true here, AND (2) a SEPARATE sealing key
# below is configured, AND (3) the owner consented and their last inbound is inside the
# 24h window. Outside the window or without consent delivery simply falls back to the
# existing next-inbound queue. Set the flag to anything other than 'true' to keep it off.
WHATSAPP_PROACTIVE_DELIVERY=false
# Dedicated 32-byte hex key that seals the owner's wa_id at rest for proactive push.
# MUST be DIFFERENT from ENCRYPTION_MASTER_KEY, STORAGE_PATH_KEY and the identity HMAC
# key, so a leaked register key can never unmask identities (and vice-versa). The sealed
# value is written server-side only, never logged, and is DELETED (nulled) on opt-out.
# Only needed when WHATSAPP_PROACTIVE_DELIVERY=true; migration
# 20261026000001_proactive_delivery.sql must be applied to store the consent columns.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_PROACTIVE_KEY=

# Gemini fallback for ambiguous spreadsheet headers (layout labels only, never row values).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# 32-byte hex master key for local AES-256-GCM payload encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

# Dedicated 32-byte hex key for the HMAC that derives opaque object paths.
# MUST be different from ENCRYPTION_MASTER_KEY and WHATSAPP_IDENTITY_HMAC_KEY.
# REQUIRED with ENCRYPTION_MASTER_KEY for any invoice upload (fail-closed).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_PATH_KEY=

# OPTIONAL SIGNED-LINK WEB REVIEW (/api/review/[token]). OFF by default. When
# enabled, a WhatsApp-only owner (no Supabase login) can open a stateless HMAC-signed,
# expiring link that reviews EXACTLY ONE invoice bound to ONE workspace — no session,
# no workspace dump. The link never bypasses a validator: it runs the SAME shared
# applyInvoiceReview as the authenticated + WhatsApp paths, so a still-invalid row
# stays needs_review. Requires BOTH the flag AND the dedicated key below; leave the
# flag unset/'false' to expose no surface at all (the route returns 503 before any DB
# touch). REVIEW_LINK_KEY MUST differ from every other key so a leak elsewhere cannot
# mint review links. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVIEW_LINKS_ENABLED=false
REVIEW_LINK_KEY=
# Signed-link lifetime in seconds (optional). Default 7 days, hard-capped at 30 days
# so a misconfiguration can never mint a perpetual mutation link.
REVIEW_LINK_TTL_SECONDS=

# Supabase Storage bucket slugs. Defaults match the provisioned private buckets.
SUPABASE_INVOICES_BUCKET=billora-invoices
SUPABASE_EXPORTS_BUCKET=billora-exports

# Invoice extraction provider. EXTRACTION_VISION_MODEL defaults to GEMINI_MODEL
# when empty. Gemini is used only when the privacy gate below is enabled.
EXTRACTION_PROVIDER=gemini
EXTRACTION_MIN_CONFIDENCE=0.8
EXTRACTION_AMOUNT_TOLERANCE_MINOR_UNITS=101
EXTRACTION_VISION_MODEL=

# Gemini latency ceilings (ms). A single read is aborted after VISION_TIMEOUT_MS
# (default 40000); raise it if your key/region is slower, lower it on a fast
# paid key. VISION_MAX_TOTAL_MS (default 50000) bounds ALL Gemini work for one
# invoice: the bounded second-pass re-read is skipped if it would not fit, so a
# throttled key never spends two slow reads and exceeds the worker's 60s limit.
VISION_TIMEOUT_MS=40000
VISION_MAX_TOTAL_MS=50000

# ---- HYBRID extraction: LOCAL-FIRST parser + OPTIONAL gated AI fallback --------
# This is NOT a fully offline product. Extraction runs a real LOCAL PDF text
# engine first (private: pdf.js reads the embedded text layer, no network), then
# — only if you enable it — uses Google Gemini as an AI ASSISTANT for fields the
# local parser could not resolve. AI can fill gaps; it never overrules a valid
# local value, and its output is independently re-validated before anything is
# auto-approved.
#
# Local extraction uses pdf.js for PDF text, Tesseract.js for images and scanned
# PDF pages (up to 10 pages), plus Sharp for orientation, contrast and resolution
# normalization. The English model `eng.traineddata` is loaded from the project
# root and must be included in the production deployment. PDF rendering is
# limited to 2,400 pixels per dimension.
LOCAL_OCR_ENGINE=pdfjs-text

# AI PRIVACY GATE. Leave EXTRACTION_ALLOW_AI=false until you have personally
# completed the provider's PAID API activation and reviewed its data-processing
# terms. Setting it true is the operator's explicit confirmation that Gemini is
# on a verified paid tier; until then NOTHING leaves the server and unresolved
# documents simply go to needs_review (never a silent cloud call).
#
# DATA EXPOSURE WARNING: enabling AI sends a rendered image (or the document
# bytes) of a real customer invoice to Google. Only enable after paid activation
# is actually complete — free-tier endpoints may use submitted content.
#
# AI may only be enabled with a paid-tier authorization, a non-placeholder
# Gemini API key, and EXTRACTION_PROVIDER=gemini. If any requirement is missing,
# configuration validation fails instead of sending customer documents.
EXTRACTION_ALLOW_AI=false
# AI may only run under a confirmed PAID tier. 'free' can use content for
# training/human review, so it must never carry real customer invoices.
EXTRACTION_AI_TIER=paid
# PARALLEL VISION. OFF by default: Gemini is contacted only when the LOCAL engine
# is insufficient (the privacy/cost-preserving behavior). When true (and AI is
# allowed + keyed) the FIRST Gemini pass runs concurrently with local OCR to cut
# latency, and is consumed even when local looked sufficient — so it spends one
# vision call per invoice. That extra provider spend + PII exposure is the explicit
# trade-off you opt into; the bounded second pass is still skipped whenever the two
# sources reconcile. Ignored entirely unless EXTRACTION_ALLOW_AI is also true.
EXTRACTION_VISION_PARALLEL=false

# IMAGE-QUALITY GATE (§P3-13). ON by default for raster (image) uploads. A real
# sharp focus check (Laplacian variance) + minimum-resolution check runs before a
# row can be trusted; a blurry or too-small photo is flagged in plain English and
# forced to needs_review. It NEVER auto-approves — it can only reduce over-approval.
# PDFs are exempt. Set to false to disable the gate entirely.
IMAGE_QUALITY_GATE=true
# Optional thresholds; leave unset to use lib/ocr/quality.ts defaults
# (blurVarianceAtMost=100, minLongEdge=500, minPixels=250000). Lower the blur max
# (or raise the min resolution) to flag MORE images; raise it to flag fewer.
# IMAGE_BLUR_VARIANCE_MAX=100
# IMAGE_MIN_LONG_EDGE=500
# IMAGE_MIN_PIXELS=250000

# Public origin used to build the AUTHENTICATED workbook download link
# (encrypted at rest; served only via /api/exports/[id]/download after a
# workspace-membership re-check). When empty, registers are still generated but
# no download link is delivered. Set to your deployed https origin in prod.
PUBLIC_APP_URL=

# Background job worker (POST /api/jobs/worker). The queue itself lives in
# Postgres; this secret only guards the external trigger endpoint. Leave empty
# to keep the endpoint disabled (503 WORKER_DISABLED).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=
# Lease length in seconds. A crashed worker's job returns to the queue once its
# lease lapses, so this is the crash-recovery delay (clamped 30-1800 in SQL).
JOB_LEASE_SECONDS=120
# Jobs claimed per tick (clamped 1-25) and the self-imposed tick time budget.
JOB_TICK_LIMIT=3
# How many of those jobs one tick processes CONCURRENTLY (clamped 1-25 and never
# above JOB_TICK_LIMIT). Higher = lower batch latency but more simultaneous
# Gemini/storage load; keep modest on the free AI tier. Default 3.
JOB_CONCURRENCY=3
JOB_TICK_BUDGET_MS=45000
# A job only STARTS if at least this much of the tick budget remains (the first
# job of a tick always runs). Keeps a slow AI call from running past the 60s
# function limit. Keep (JOB_TICK_BUDGET_MS - JOB_MIN_WINDOW_MS) >= 1 AI job.
JOB_MIN_WINDOW_MS=20000
# Retry backoff: retry_in = base * 2^(attempt-1), capped. Attempts beyond
# max_attempts settle the job permanently in the database.
JOB_BACKOFF_BASE_SECONDS=15
JOB_BACKOFF_CAP_SECONDS=900

