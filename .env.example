# Copy to .env.local and fill in real values. Never commit .env.local.
# Client-side (browser). MUST be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
# Required by /api/health/supabase and any service_role code.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://xyzcompany.supabase.co/auth/v1/.well-known/jwks.json

# Legacy unprefixed fallbacks (accepted by server code, prefer NEXT_PUBLIC_*).
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
