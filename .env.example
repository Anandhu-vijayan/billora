# Copy to .env.local and fill in real values. Never commit .env.local.
# Client-side (browser). MUST be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
# Required by /api/health/supabase and any service_role code.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://xyzcompany.supabase.co/auth/v1/.well-known/jwks.json

# WhatsApp Cloud API (webhook verification + media download).
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App Secret on the Meta dashboard. Validates the
# X-Hub-Signature-256 webhook header. REQUIRED in production (fail-closed).
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Keyed HMAC for WhatsApp sender identities (server only, never NEXT_PUBLIC_).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_IDENTITY_HMAC_KEY=

# Gemini fallback for ambiguous spreadsheet headers (layout labels only, never row values).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 32-byte hex master key for local AES-256-GCM payload encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

# Background job worker (POST /api/jobs/worker). The queue itself lives in
# Postgres; this secret only guards the external trigger endpoint. Leave empty
# to keep the endpoint disabled (503 WORKER_DISABLED).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=
# Lease length in seconds. A crashed worker's job returns to the queue once its
# lease lapses, so this is the crash-recovery delay (clamped 30-1800 in SQL).
JOB_LEASE_SECONDS=120
# Jobs claimed per tick (clamped 1-25) and the self-imposed tick time budget.
JOB_TICK_LIMIT=3
JOB_TICK_BUDGET_MS=45000
# Retry backoff: retry_in = base * 2^(attempt-1), capped. Attempts beyond
# max_attempts settle the job permanently in the database.
JOB_BACKOFF_BASE_SECONDS=15
JOB_BACKOFF_CAP_SECONDS=900

