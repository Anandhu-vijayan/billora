# Copy to .env.local and fill in real values. Never commit .env.local.
# Client-side (browser). MUST be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
# Required by /api/health/supabase and any service_role code.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://xyzcompany.supabase.co/auth/v1/.well-known/jwks.json

# WhatsApp Cloud API (webhook verification + media download).
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App Secret on the Meta dashboard. Validates the
# X-Hub-Signature-256 webhook header. REQUIRED in production (fail-closed).
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Keyed HMAC for WhatsApp sender identities (server only, never NEXT_PUBLIC_).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_IDENTITY_HMAC_KEY=

# Gemini fallback for ambiguous spreadsheet headers (layout labels only, never row values).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 32-byte hex master key for local AES-256-GCM payload encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

